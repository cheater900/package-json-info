# Copy to .env.local and fill in. VITE_* values end up in the client bundle.

# GitHub personal access token (no scopes needed). Raises the GitHub API
# rate limit from 60 to 5000 requests per hour. Leave empty for anonymous.
VITE_GITHUB_TOKEN=

# Packages fetched in parallel per table. Defaults to 5.
VITE_FETCH_CONCURRENCY=

# Milliseconds before a network request is aborted. Defaults to 30000.
VITE_FETCH_TIMEOUT_MS=
