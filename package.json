{
    "name": "package-json-info",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "preview": "vite preview",
        "screenshots": "playwright test --project=screenshots",
        "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
        "test:e2e": "playwright test --project=chromium",
        "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "vue": "^3.5.44",
        "vue-json-pretty": "^2.6.0",
        "vuedraggable": "^4.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.5.0",
        "fake-indexeddb": "^6.2.7",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.80.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.12",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.14"
    }
}
