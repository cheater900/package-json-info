{
    "name": "package-json-info",
    "version": "0.0.0",
    "private": true,
    "bin": {
        "package-json-info": "dist-cli/main.js"
    },
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:cli": "vite build --ssr src/cli/main.ts --outDir dist-cli",
        "dev": "vite",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "preview": "vite preview",
        "screenshots": "playwright test --project=screenshots",
        "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
        "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage TEST_TIME_SCALE=10 vitest run --coverage",
        "test:e2e": "playwright test --project=chromium",
        "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit -p src/core && tsc --noEmit -p src/cli"
    },
    "dependencies": {
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.9",
        "vue": "^3.5.44",
        "vue-json-pretty": "^2.6.0",
        "vuedraggable": "^4.1.0",
        "write-excel-file": "^4.1.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/coverage-v8": "^4.1.12",
        "@vue/test-utils": "^2.5.0",
        "fake-indexeddb": "^6.2.7",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.80.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.12",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.14"
    }
}
