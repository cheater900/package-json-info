{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "vue"],
    "categories": {
        "correctness": "error"
    },
    "rules": {},
    "env": {
        "builtin": true
    },
    "overrides": [
        {
            "files": ["src/core/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["vue", "vue-*", "vuedraggable"],
                                "message": "src/core must stay framework-free."
                            },
                            {
                                "group": ["**/app/**", "**/app"],
                                "message": "src/core must not import src/app."
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
