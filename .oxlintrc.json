{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "vue"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "curly": ["error", "all"]
    },
    "env": {
        "builtin": true
    },
    "overrides": [
        {
            "files": ["src/core/**", "src/cli/**"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["vue", "vue-*", "vuedraggable"],
                                "message": "src/core and src/cli must stay framework-free."
                            },
                            {
                                "group": ["**/app/**", "**/app"],
                                "message": "src/core and src/cli must not import src/app; share code through src/core."
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
